# Copy sang .env roi sua. File .env khong duoc commit.

# --- MySQL: cai san tren may, KHONG chay trong Docker ---------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_DB=library_db
# DB rieng cho pytest. Bi drop/tao lai moi lan chay test, nen KHONG duoc
# tro vao library_db. Ten bat buoc ket thuc bang _test_db.
MYSQL_TEST_DB=library_test_db

# --- Chung ----------------------------------------------------------------
LOG_LEVEL=INFO
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
